# Copy to .env, then: composer install && php artisan key:generate
#
#   cp .env.example .env

APP_NAME="Futsal Nepal API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Where the API itself is served. Used to build the eSewa/Khalti return URLs
# and the links inside notification bodies.
APP_URL=http://localhost:8000
# Where the Expo app is served, so gateway callbacks can send the player back
# into the app instead of to a bare JSON response.
APP_WEB_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL
# ---------------------------------------------------------------------------
# Create the database once, then `php artisan migrate --seed`:
#
#   mysql -u root -p -e "CREATE DATABASE futsal CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# The app never relies on MySQL-specific SQL, so switching DB_CONNECTION=sqlite
# (and creating database/database.sqlite) works for a quick local run.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=futsal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CORS — the Expo app runs on another origin
# ---------------------------------------------------------------------------
# "*" is right for local development: the web build is served by Metro on
# :8081 and a phone hits the API over the LAN. In production, list the real
# app origins, comma-separated.
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Payment gateways
# ---------------------------------------------------------------------------
# Left blank, both gateways fall back to their public sandbox credentials and
# URLs, so a fresh checkout can take a test payment with no configuration.
# Real merchant credentials in production.

ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

KHALTI_SECRET_KEY=
KHALTI_INITIATE_URL=
KHALTI_LOOKUP_URL=

# ---------------------------------------------------------------------------
# Money & loyalty
# ---------------------------------------------------------------------------
# How long after an owner marks a booking settled that a mistyped ledger
# entry can still be corrected, in minutes. After this the ledger locks.
SETTLE_EDIT_WINDOW_MINUTES=30
