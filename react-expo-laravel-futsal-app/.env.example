# Copy to .env and adjust. `.env` is gitignored; this template is not.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL 14+. Both the app (src/db/index.ts) and the schema tooling
# (drizzle.config.ts) read this same variable.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Backend origin — the Expo + Laravel migration switch
# ---------------------------------------------------------------------------
# Every network call in src/ goes through src/lib/api.ts, which prefixes paths
# with this value.
#
# Leave it UNSET to run against this Next.js app's own /api routes, which is the
# default and how the app runs today. With it unset the base is "" and every
# call resolves to the same relative path it always did.
#
# Set it when the backend moves — either to Laravel on its own host, or when
# this UI is loaded inside an Expo app, where there is no origin for a relative
# URL to resolve against and an absolute one is required.
#
#   NEXT_PUBLIC_API_BASE=https://api.yourdomain.com
#
# It must keep the NEXT_PUBLIC_ prefix, otherwise the value is not inlined into
# the client bundle and the browser sees undefined.
# NEXT_PUBLIC_API_BASE=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Where tests/api/*.mjs send their requests. Defaults to the local dev server.
# Point it at a Laravel host to use those suites as an acceptance suite — see
# the "Porting this to React Native (Expo) and Laravel" section of the README
# for the seeded-data caveats.
# BASE_URL=http://127.0.0.1:3000
