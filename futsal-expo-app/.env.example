# Where the backend lives.
#
# Expo inlines only EXPO_PUBLIC_* variables into the bundle at build time, so the
# prefix is mandatory — a plain API_BASE would be undefined at runtime.
#
# React Native has no origin, so this must be an absolute URL. There is no
# same-origin default like the web app has.
#
#   iOS simulator      -> http://localhost:8000
#   Android emulator   -> http://10.0.2.2:8000
#   Physical device    -> http://<your-machine-LAN-IP>:8000
#
# `localhost` on a physical device is the device itself, not your computer — the
# most common reason a fresh Expo app cannot reach a local API.
#
# The API is the Laravel service in ../laravel. Use port 8000 for local
# development. The value must be an absolute URL because native Expo has no
# browser origin to resolve relative URLs against.
EXPO_PUBLIC_API_BASE=http://localhost:8000

# Optional Expo web proxy override. Metro already defaults to Laravel on
# 127.0.0.1:8000. Keep this separate from EXPO_PUBLIC_API_BASE: the Android
# emulator address 10.0.2.2 is not a valid target from the Metro host process.
# EXPO_WEB_API_PROXY=http://127.0.0.1:8000
